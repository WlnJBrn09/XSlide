{
  "name": "xslide",
  "version": "1.1.0",
  "description": "XSlide — local-first presentation app with liquid glass UI and Rust backend",
  "author": "XSlide",
  "license": "MIT",
  "private": true,
  "scripts": {
    "backend": "cargo run --release",
    "backend:build": "cargo build --release",
    "start": "cargo run",
    "native": "npm run native:build && node scripts/run-native.js",
    "native:build": "cargo build --release && cargo build --release --manifest-path native-host/Cargo.toml",
    "native:headless": "npm run native:build && node scripts/run-native.js --headless",
    "icon": "node scripts/make-icon.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native-win.ps1",
    "dist:deb": "npm run native:build && python3 scripts/package-deb.py XSlide",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native-win.ps1"
  },
  "devDependencies": {
    "png-to-ico": "^2.1.8"
  }
}
